# Copy to .env for `npm run dev`; set the same names in Vercel > Settings > Environment Variables.
# Never commit real values.

# --- Server only (api/judge.js) ---
# Oracle signing key, 64 hex chars. Generate with: npm run oracle-key
ORACLE_PRIVKEY_HEX=
# Claude API key for photo judging. Without it, photo mode returns 503; sample proof and Give up still work.
ANTHROPIC_API_KEY=
# Set to 1 to turn off the always-pass "demo sample proof" (recommended for real-money use).
DISABLE_SAMPLE=

# --- Browser (baked in at build time) ---
# chipnet (default) or mainnet
VITE_NETWORK=chipnet
# Where the flat 1% platform fee goes. Must match VITE_NETWORK (bchtest:... or bitcoincash:...).
VITE_FEE_ADDRESS=
# Preset beneficiaries, "Label=address,Label=address". Empty address = disabled chip.
VITE_BENEFICIARIES=A charity=,A friend=
# Banner links (required by BCH BLAZE)
VITE_SLIDES_URL=
VITE_REPO_URL=https://github.com/cyberhooman/bchblaze-pact
# CashTokens address for EMBER2026 votes
VITE_VOTE_ADDRESS=
# USD price used only if the live price fetch fails
VITE_BCH_USD=400
